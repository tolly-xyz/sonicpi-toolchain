#!/usr/bin/env ruby
# Render a song's klattsch voices (the KLATT table between the "# ---- klattsch voices" markers).
# usage: sp-klatt SONG.rb      needs node; uses the bundled vendor/klattsch (with banks/*.json) unless KLATTSCH is set
SP_ROOT = File.expand_path("..", __dir__)
KLATTSCH = ENV["KLATTSCH"] || "#{SP_ROOT}/bin/klatt-render.mjs"
require "digest"
BANKS = Digest::SHA1.hexdigest(Dir["#{SP_ROOT}/banks/*.json"].sort.map { |f| File.read(f) }.join)   # re-render when a bank changes
src = File.read(ARGV[0], encoding: "utf-8")
block = src[/^# ---- klattsch voices\n(.*?)^# ---- end klattsch voices/m, 1] or exit 0
def note(n) = n
eval(block)
require "fileutils"; FileUtils.mkdir_p(KDIR)
# A KLATT entry may be a klattsing spec (a Hash: mode, text, notes, bpm, voice, preset options ...) instead
# of a klattsch string; specs render through klattsing itself (inline banks, bankPatch and breath
# aspiration only exist inside its process), cached by the spec and klattsing's sources.
require "json"; require "open3"
KSRC = Digest::SHA1.hexdigest(Dir["#{SP_ROOT}/klattsing/{src,bin}/*"].sort.map { |f| File.read(f) }.join)
KLATT.select { |_, v| v.is_a?(Hash) }.each do |name, spec|
  out = "#{KDIR}/#{name}.wav"; stamp = "#{out}.txt"; key = "#{JSON.generate(spec)}\n#{BANKS}\n#{KSRC}"
  next if File.exist?(out) && File.exist?(stamp) && File.read(stamp) == key
  _, err, st = Open3.capture3("node", "#{SP_ROOT}/klattsing/bin/klattsing.mjs", "-", out, stdin_data: JSON.generate(spec))
  abort "klattsing failed on #{name}: #{err}" unless st.success?
  File.write(stamp, key)
end
KLATT.reject! { |_, v| v.is_a?(Hash) }
KLATT.each do |name, text|
  out = "#{KDIR}/#{name}.wav"; stamp = "#{out}.txt"
  next if File.exist?(out) && File.exist?(stamp) && File.read(stamp) == "#{text}\n#{BANKS}"   # unchanged
  ok = system("node", KLATTSCH, text, out, err: "#{out}.log")
  abort "klattsch failed on #{name}: #{File.read("#{out}.log")}" unless ok
  warn "klattsch #{name}: #{File.read("#{out}.log").strip}"
  File.write(stamp, "#{text}\n#{BANKS}")
end
