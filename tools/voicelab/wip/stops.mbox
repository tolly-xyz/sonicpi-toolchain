+    for k, c in t.items():
+        print(f"{k:14s} n {c['n']:3d}  bMCD {c['burst_mcd']:5.2f}  " + "  ".join(f"{q} {c[q][0]:.0f}/{c[q][1]:.0f}" for q in KEYS if q in c))
