diff --git a/vendor/klattsch/src/engine/dsp.js b/vendor/klattsch/src/engine/dsp.js
index 9631806..d97fcb6 100644
--- a/vendor/klattsch/src/engine/dsp.js
+++ b/vendor/klattsch/src/engine/dsp.js
@@ -40,6 +40,49 @@ export class BandpassBiquad {
   }
 }
 
+// (sonicpi-toolchain patch) Klatt (1980) digital resonator and antiresonator, both with unity gain at 0 Hz:
+//   resonator      y[n] = A x[n] + B y[n-1] + C y[n-2]   C = -exp(-2 pi BW T), B = 2 exp(-pi BW T) cos(2 pi F T), A = 1 - B - C
+//   antiresonator  y[n] = A' x[n] + B' x[n-1] + C' x[n-2]   A' = 1/A, B' = -B/A, C' = -C/A (A, B, C of a resonator at F, BW)
+// A resonator and an antiresonator at the same F and BW cancel exactly (Klatt's FNP = FNZ for non-nasal sounds).
+// Coefficients are recomputed only when frequency or bandwidth changes. Used only by the nasal path (synth-core).
+function klattCoefs(f, bw, sr) {
+  f = Math.max(0, Math.min(sr * 0.45, f));
+  bw = Math.max(1, bw);
+  const T = 1 / sr;
+  const C = -Math.exp(-2 * Math.PI * bw * T);
+  const B = 2 * Math.exp(-Math.PI * bw * T) * Math.cos(2 * Math.PI * f * T);
+  return [1 - B - C, B, C];
+}
+export class KlattResonator {
+  constructor() { this.y1 = 0; this.y2 = 0; this.a = 1; this.b = 0; this.c = 0; this.lastF = -1; this.lastBW = -1; }
+  setFreq(f, bw, sr) {
+    if (f === this.lastF && bw === this.lastBW) return;
+    this.lastF = f; this.lastBW = bw;
+    [this.a, this.b, this.c] = klattCoefs(f, bw, sr);
+  }
+  process(x) {
+    const y = this.a * x + this.b * this.y1 + this.c * this.y2;
+    this.y2 = this.y1; this.y1 = y;
+    return y;
+  }
+  reset() { this.y1 = 0; this.y2 = 0; }
+}
+export class KlattAntiresonator {
+  constructor() { this.x1 = 0; this.x2 = 0; this.a = 1; this.b = 0; this.c = 0; this.lastF = -1; this.lastBW = -1; }
+  setFreq(f, bw, sr) {
+    if (f === this.lastF && bw === this.lastBW) return;
+    this.lastF = f; this.lastBW = bw;
+    const [A, B, C] = klattCoefs(f, bw, sr);
+    this.a = 1 / A; this.b = -B / A; this.c = -C / A;
+  }
+  process(x) {
+    const y = this.a * x + this.b * this.x1 + this.c * this.x2;
+    this.x2 = this.x1; this.x1 = x;
+    return y;
+  }
+  reset() { this.x1 = 0; this.x2 = 0; }
+}
+
 // Derivative of the Rosenberg glottal pulse. Phase normalized to [0, 1).
 // Peak |value| is pi / (2·Tn) ~= 9.82, so we divide by 10 to keep amplitude
 // near unity.
diff --git a/vendor/klattsch/src/engine/sequencer.js b/vendor/klattsch/src/engine/sequencer.js
index 5500fdb..f1c30ec 100644
--- a/vendor/klattsch/src/engine/sequencer.js
+++ b/vendor/klattsch/src/engine/sequencer.js
@@ -1,6 +1,7 @@
 // Phoneme-string parser and schedule compiler
 
 import { banks, resolveBank } from './banks/index.js';
+import { NASAL_PARAMS, NASAL_DEFAULT } from './synth-core.js';
 
 const PAUSE_MS = { ',': 100, ';': 200, '.': 300 };
 
@@ -28,7 +29,13 @@ const DEFAULTS = Object.freeze({
   sentenceFinalHoldMs: 0,
   fadeOutMs: 100,
   trailOffMs: 150,
+  // (sonicpi-toolchain patch) [NAS=x]: share of a vowel nasalized before a nasal consonant ([NASVC]) and after
+  // one ([NASCV]), and the nasal parameters of a fully nasalized vowel (a nasal pole-zero pair, Klatt 1980)
+  nasalVC: 0.5,
+  nasalCV: 0.3,
+  nasalized: Object.freeze({ FNP: 250, BNP: 100, FNZ: 450, BNZ: 100, AN: 0 }),
 });
+const NASAL_FREQ = /^(F|B)N[PZ]2?$/;   // nasal pole/zero frequencies and bandwidths: they follow the formant scale
 
 const HOMOGLYPH_MAP = {
   // Greek uppercase that look like Latin uppercase
@@ -246,16 +253,91 @@ function compileSection(tokens, opts = {}, source = '', sectionSrcStart = 0) {
     // engine reading them tracks the running formant scale like F1-3 do.
     for (const k of Object.keys(src)) {
       if (/^(F|BW)[4-9]$/.test(k)) out[k] = src[k] * scale;
+      else if (NASAL_FREQ.test(k)) out[k] = src[k] * scale;    // (sonicpi-toolchain patch) a bank's nasal pole/zero
     }
+    // (sonicpi-toolchain patch) a bank's nasal fields act only with [NAS] (which also resets them after a nasal)
+    if (!nasalMode()) for (const k of NASAL_PARAMS) delete out[k];
     return out;
   };
 
+  // (sonicpi-toolchain patch) nasals. Once [NAS=x] is set, every phoneme's first event (and every silence) carries
+  // all nasal parameters: a nasal consonant's own (bank fields FNP, BNP, FNZ, BNZ, AN, FNP2 ..., and nasal: true),
+  // neutral ones (the pairs cancel, AN 0) for everything else, so a murmur never leaks into what follows. A vowel-
+  // like neighbour of a nasal consonant (voicing >= 1, not a stop, not nasal; no pause between) is nasalized: from
+  // the first [NASVC] of it before a nasal consonant it glides to the nasalized values (DEFAULTS.nasalized, over
+  // which the consonant's bank field nasalizes {...} is laid), and after one it starts nasalized and is back to
+  // neutral after [NASCV] of it; x scales the nasalization (0: murmurs only). The vowel's nasal glides are
+  // nasalOnly events, which move only the nasal parameters. Without [NAS] nothing here runs.
+  let nasalNeighbours = null;
+  const nasalMode = () => nasalNeighbours !== null && extras.NAS !== undefined;
+  if (opts.extras?.NAS !== undefined || tokens.some((t) => t.type === 'directive' && t.key === 'NAS')) {
+    nasalNeighbours = new Map();
+    let prev = null;
+    for (const t of tokens) {
+      if (t.type === 'pause' || (t.type === 'directive' && t.key === 'pause')) { prev = null; continue; }
+      if (t.type !== 'phoneme') continue;
+      nasalNeighbours.set(t, { prev, next: null });
+      if (prev) nasalNeighbours.get(prev).next = t;
+      prev = t;
+    }
+  }
+  let pendingNasal = null;     // nasal parameters for the next emit (the first event of a phoneme)
+  let nasalOnlyEvents = 0;
+  const nasalScaled = (x) => {
+    const out = {};
+    for (const k of NASAL_PARAMS) if (k in x) out[k] = NASAL_FREQ.test(k) ? x[k] * scale : x[k];
+    return out;
+  };
+  const nasalOf = (code) => { const e = code ? phonemes[code] : null; return e && e.nasal ? e : null; };
+  // the nasal parameters of a vowel next to nasal consonant entry n, at strength x
+  const nasalizedBy = (n) => {
+    const x = extras.NAS, full = { ...NASAL_DEFAULT, ...DEFAULTS.nasalized, ...(n.nasalizes ?? {}) }, out = {};
+    for (const k of NASAL_PARAMS) out[k] = NASAL_DEFAULT[k] + x * (full[k] - NASAL_DEFAULT[k]);
+    return nasalScaled(out);
+  };
+  const nasalOnly = (atMs, target, transitionMs) => {
+    const ex = {};
+    for (const k of NASAL_PARAMS) if (k in extras) ex[k] = extras[k];
+    schedule.push({ atMs, target: { ...target, ...ex }, transitionMs, nasalOnly: true });
+    nasalOnlyEvents++;
+  };
+  // before a phoneme renders: its first event's nasal parameters; after: the vowel's nasal glides
+  const nasalBefore = (t, p) => {
+    if (!nasalMode()) return null;
+    pendingNasal = nasalScaled(NASAL_DEFAULT);
+    if (p.nasal || p.isStop || !((p.voicing ?? 0) >= 1)) return null;
+    const nb = nasalNeighbours.get(t) ?? {};
+    const prevN = nasalOf(nb.prev?.code), nextN = nasalOf(nb.next?.code);
+    if (!prevN && !nextN) return null;
+    const cv = extras.NASCV ?? DEFAULTS.nasalCV, vc = extras.NASVC ?? DEFAULTS.nasalVC;
+    if (prevN) pendingNasal = nasalizedBy(prevN);
+    else if (vc >= 1) pendingNasal = nasalizedBy(nextN);
+    return { start: timeMs, prevN, nextN, cv, vc };
+  };
+  const nasalAfter = (plan, slotMs) => {
+    if (!plan) return;
